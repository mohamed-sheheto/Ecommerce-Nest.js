# Copy this file to .env and fill in real values
# cp .env.example .env

# App
PORT=3000
BCRYPT_ROUNDS=10

# JWT (use long random strings in production)
JWT_SECRET=example_jwt_secret_change_me_please_1234567890
JWT_SECRET_REFRESHTOKEN=example_jwt_refresh_secret_change_me_please_1234567890

# Nodemailer / Gmail
MAIL_USER=example-shop@example.com
EMAIL_USERNAME=example-shop@gmail.com
EMAIL_PASSWORD=example_app_password_1234

# Stripe
STRIPE_SECRET_KEY=sk_test_example1234567890EXAMPLE123456
STRIPE_WEBHOOK_SECRET=whsec_example1234567890EXAMPLE123456

# Cloudinary
CLOUDINARY_NAME=example-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=example_cloudinary_api_secret_AbC123

# Google OAuth
GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
